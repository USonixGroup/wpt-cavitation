    "    {0: \"measurement\", 1: \"broadband\", 2: \"fundamental\"}\n",
    "]\n",
    "for i, r in enumerate(exp_results):\n",
    "    label_map = label_maps[i]\n",
    "    # unpack results\n",
    "    data_train, tr_obj, centers, labels, sampling_rate, freq_threshold = r\n",
    "    fig = plot.plot_clustering(\n",
