    "from wavelet_transform.postprocess.plotting import get_reconstructions_by_group\n",
    "import plotly.graph_objects as go\n",
    "recs = get_reconstructions_by_group(tr_obj, labels_sorted, freq_threshold)\n",
    "fig = go.Figure()\n",
    "fig.add_trace(\n",
    "    go.Scatter(\n",
    "        x=t_plot,\n",
    "        y=sum(recs),\n",
    "        mode=\"lines\",\n",
    "        name=\"Signal with freq thresholding\",\n",
    "    )\n",
    ")\n",
    "fig.add_trace(\n",
    "    go.Scatter(\n",
    "        x=t_plot,\n",
    "        y=tr_obj.data,\n",
    "        mode=\"lines\",\n",
    "        name=\"Orignial signal\"\n",
    "    )\n",
    ")\n"
   ]
