        {
            "cell_type": "code",
            "execution_count": 11,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Parameters for the wavelet transform\n",
                "wavelet = \"db20\"\n",
                "levels = 12  # set to None to use max-level transform\n",
                "mode = \"symmetric\"\n",
                "use_min_entropy = True\n",
                "min_level = 5"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 12,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Plot PCD data and the excitation sound wave\n",
                "# fft_lim = 5\n",
                "# fig = make_subplots(rows=1, cols=1)\n",
                "# fig.add_trace( go.Scatter(x=t_plot, y=data, mode='lines',name='data'),\n",
                "#               row=1,col=1)\n",
                "# # fig.add_trace( go.Scatter(x=t_plot, y=excitation_data ,mode='lines', name = 'excitation data'),\n",
                "# #               row=1,col=1)\n",
                "\n",
                "# fig.update_layout(height=600, width=1000,\n",
