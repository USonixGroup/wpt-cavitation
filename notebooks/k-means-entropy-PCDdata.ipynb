                "pcd_number = 1\n",
                "voltage = 80\n",
                "data, t_plot = pcd.get_data((voltage, pcd_number))  # [80, 120, 200, 280], [1, 5, 10]\n",
                "\n",
                "no_clusters = (3, 6)\n",
                "result_id = f\"{voltage}_{pcd_number}_{no_clusters}\""
