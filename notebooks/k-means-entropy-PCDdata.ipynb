        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## Wavelet transform"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 17,
            "metadata": {},
            "outputs": [],
            "source": [
                "wpt_df, tr_obj = train.generate_training_data(\n",
                "    data_processed, levels, wavelet, mode, \n",
                "    include_tr_obj=True, min_entropy=use_min_entropy,\n",
                "    min_level=min_level, freq_threshold=freq_threshold\n",
                ")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## Training"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 18,
            "metadata": {},
            "outputs": [],
            "source": [
                "# k-means parameters\n",
                "kmeans_params = {\n",
                "    \"init\": \"k-means++\",\n",
                "    \"n_init\":10,\n",
                "    \"max_iter\":100,\n",
                "    \"tol\":1e-8,\n",
                "    \"verbose\":0,\n",
                "    \"algorithm\":\"lloyd\",\n",
                "}\n",
                "\n",
                "# training data\n",
                "classifying_metrics = [\n",
                "    \"log average energy\",\n",
                "    \"kurtosis\",\n",
                "    # \"crest factor\",\n",
                "    # \"level entropy\",\n",
                "    \"spectral entropy\",\n",
                "    \"average energy\",\n",
                "    # \"skewness\"\n",
                "]\n",
                "# Set to no_clusters to None to select optimal number of clusters by silhouette score\n",
                "use_inverse_metrics = False\n",
                "scale_data = \"standard\"\n",
                "if use_inverse_metrics is True:\n",
                "    inv_tr_obj = inv.InverseTransform(tr_obj)  # Use info from inverse transform object instead\n",
                "    wpt_df_train = inv_tr_obj.info(leaf_nodes=True, freq_threshold=freq_threshold)\n",
                "else:\n",
                "    wpt_df_train = wpt_df.copy()"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 19,
            "metadata": {},
            "outputs": [],
            "source": [
                "data_train, labels, data_train_normalised, centers, scaler, kmeans = train_k_means(\n",
                "    wpt_df_train, \n",
                "    classifying_metrics, \n",
                "    no_clusters=no_clusters, \n",
                "    kmeans_params=kmeans_params, \n",
                "    scale_data=scale_data\n",
                ")"
            ]
        },
